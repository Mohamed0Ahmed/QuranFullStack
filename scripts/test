#!/usr/bin/env node

import { spawn, spawnSync } from 'node:child_process';
import { randomBytes } from 'node:crypto';
import { appendFileSync, mkdirSync, mkdtempSync, readdirSync, readFileSync, writeFileSync } from 'node:fs';
import { tmpdir } from 'node:os';
import { dirname, join, resolve } from 'node:path';
import { performance } from 'node:perf_hooks';
import { fileURLToPath } from 'node:url';

import {
  RUN_EVIDENCE_COMMAND_ID_ENVIRONMENT_VARIABLE,
  RUN_EVIDENCE_PATH_ENVIRONMENT_VARIABLE,
  assessScratchLifecycleResult,
  captureMachineLoad,
  createEmptyScratchExecutionEvidence,
  parseBackendPolicyCatalog,
  parseBackendResourceCatalog,
  planFocusedSelection,
  planPrePrSelection,
  readRunEvidenceEvents,
  retainExecutionStatusAfterTimingFailure,
  summarizeExecutionTiming,
} from './test-policy-runner.mjs';

const REPOSITORY_ROOT = resolve(dirname(fileURLToPath(import.meta.url)), '..');
const FRONTEND_ROOT = resolve(REPOSITORY_ROOT, 'Frontend/quran-dashboard-ui');
const BACKEND_CATALOG = resolve(
  REPOSITORY_ROOT,
  'Backend/tests/QuranDashboard.Tests/TestSupport/Execution/test-gates.tsv',
);
const BACKEND_RESOURCE_CATALOG = resolve(
  REPOSITORY_ROOT,
  'Backend/tests/QuranDashboard.Tests/TestSupport/Execution/test-resources.tsv',
);
const TEST_RUNTIME_ASSEMBLY = resolve(
  REPOSITORY_ROOT,
  'Backend/tools/QuranDashboard.TestRuntime/bin/Debug/net10.0/QuranDashboard.TestRuntime.dll',
);
const SCRATCH_LOCK_COMMAND = 'scratch-rehearsal';
const FULL_REHEARSAL_LOCK_COMMAND = 'full-rehearsal';

let options;
try {
  options = parseArguments(process.argv.slice(2));
} catch (error) {
  console.error(error.message);
  printUsage();
  process.exit(2);
}

const backendCatalog = parseBackendPolicyCatalog(readFileSync(BACKEND_CATALOG, 'utf8'));
const backendResources = parseBackendResourceCatalog(
  readFileSync(BACKEND_RESOURCE_CATALOG, 'utf8'),
);
let plan;
try {
  if (options.mode === 'focused') {
    plan = planFocusedSelection({
      backendCatalog,
      backendResources,
      backendClasses: options.backendClasses,
      backendMethods: options.backendMethods,
      buildMode: options.buildMode,
      playwrightSelections: resolvePlaywrightSelections(options.playwrightSelectors),
      authorizeFullData: options.authorizeFullData,
    });
  } else {
    plan = planPrePrSelection({
      backendCatalog,
      backendResources,
      affectedFeatures: options.affectedFeatures,
      affectedConcerns: options.affectedConcerns,
      authorizeFullData: options.authorizeFullData,
      explicitPolicy: options.explicitPolicy,
    });
  }
} catch (error) {
  console.error(error.message);
  process.exit(2);
}

const materializedPlan = {
  ...plan,
  commands: plan.commands.map((command) => ({
    ...command,
    cwd: resolve(REPOSITORY_ROOT, command.cwd),
  })),
};

if (options.dryRun) {
  console.log(JSON.stringify(materializedPlan, null, 2));
  process.exit(0);
}

const hasWithheldFullData = plan.authorizationRequired?.length > 0;
if (hasWithheldFullData) {
  console.error('Full-data Destructive Rehearsal authorization is required for:');
  for (const className of plan.authorizationRequired) {
    console.error(`  ${className}`);
  }
  console.error('Safe selected checks will continue; review the targets, then rerun with --authorize-full-data.');
}

const evidenceDirectory = mkdtempSync(join(tmpdir(), 'qd-run-evidence-'));
const evidencePath = join(evidenceDirectory, 'events.ndjson');
writeFileSync(evidencePath, '');
const machineLoad = captureMachineLoad();
const evidenceEnvironment = {
  ...process.env,
  [RUN_EVIDENCE_PATH_ENVIRONMENT_VARIABLE]: evidencePath,
};

const executionRecords = [];
const runStartedAt = performance.now();
let executionStatus = 0;
for (const command of materializedPlan.commands) {
  const group = command.group ? ` group=${command.group}` : '';
  console.log(`[scripts/test] ${command.id}${group} phase=${command.phase}`);
  const commandStartedAt = performance.now();
  const commandEnvironment = {
    ...evidenceEnvironment,
    [RUN_EVIDENCE_COMMAND_ID_ENVIRONMENT_VARIABLE]: command.id,
  };
  const outcome = command.group === 'EmptyScratchDestructiveRehearsal'
    ? await executeEmptyScratch(command, commandEnvironment)
    : command.group === 'FullDataDestructiveRehearsal' && command.rehearsalSubtype
      ? await executeFullRehearsal(command, commandEnvironment)
    : commandOutcome(executeCommand(command, {
      ...commandEnvironment,
      QURAN_DASHBOARD_TEST_RUN_ID: createScratchRunId(),
    }));
  collectTrxTestCases(command, evidencePath);
  executionRecords.push({
    id: command.id,
    phase: command.phase,
    group: command.group,
    status: outcome.status,
    durationMilliseconds: performance.now() - commandStartedAt,
    lockWaitMilliseconds: outcome.lockWaitMilliseconds,
    capabilityMilliseconds: outcome.capabilityMilliseconds,
  });
  if (outcome.status !== 0) {
    executionStatus = outcome.status;
    break;
  }
}

try {
  console.log(JSON.stringify(summarizeExecutionTiming({
    mode: options.mode,
    records: executionRecords,
    totalWallMilliseconds: performance.now() - runStartedAt,
    events: readRunEvidenceEvents(evidencePath),
    machineLoad,
  })));
} catch (error) {
  // Timing is evidence about the run, not the run's verdict. A defect here must never turn a passing
  // gate into a crash, nor a failing one into a pass.
  console.error(`[scripts/test] execution timing evidence could not be summarized: ${error.message}`);
  executionStatus = retainExecutionStatusAfterTimingFailure(executionStatus);
}

if (executionStatus !== 0) {
  process.exit(executionStatus);
}

if (hasWithheldFullData) {
  console.error('Safe checks completed, but full-data rehearsals remain withheld.');
  process.exit(2);
}

function commandOutcome(status, { lockWaitMilliseconds = 0, capabilityMilliseconds = 0 } = {}) {
  return { status, lockWaitMilliseconds, capabilityMilliseconds };
}

function executeCommand(command, environment = process.env) {
  const arguments_ = [...command.arguments];
  if (isBackendTestDelegate(command)) {
    const resultsDir = backendResultsDirectory(command);
    mkdirSync(resultsDir, { recursive: true });
    arguments_.push('--results-dir', resultsDir);
  }
  const result = spawnSync(command.executable, arguments_, {
    cwd: command.cwd,
    env: environment,
    stdio: 'inherit',
  });
  if (result.error) {
    console.error(`[scripts/test] ${command.id} could not start: ${result.error.message}`);
    return 1;
  }
  return result.status ?? 1;
}

async function executeEmptyScratch(command, environment = process.env) {
  if (!command.scratchSubtype) {
    console.error(`[scripts/test] ${command.id} has no approved empty-scratch subtype.`);
    return commandOutcome(2);
  }

  const totalStartedAt = performance.now();
  const runId = createScratchRunId();
  const keeperStartedAt = performance.now();
  const acquisition = await startScratchKeeper(runId, environment);
  const keeperDurationMilliseconds = performance.now() - keeperStartedAt;
  // The keeper interval also covers process startup, connection, and contract inspection. Only the
  // advisory wait TestRuntime itself measured is lock contention; the rest belongs to the command.
  const lockWaitMilliseconds = acquisition?.lockWaitMilliseconds ?? 0;
  const keeper = acquisition?.keeper;
  if (!keeper) {
    console.log(JSON.stringify(createEmptyScratchExecutionEvidence({
      command,
      runId,
      keeperStatus: 'failed',
      keeperDurationMilliseconds,
      totalDurationMilliseconds: performance.now() - totalStartedAt,
      finalStatus: 3,
    })));
    return commandOutcome(3);
  }

  let created = false;
  let executionStatus = 1;
  let testStatus = null;
  let testDurationMilliseconds = null;
  let reap = null;
  let creation = null;
  let cleanup = null;
  let keeperExitStatus = null;
  try {
    reap = runScratchLifecycle('reap', runId, null, environment);
    if (reap.status !== 0) {
      executionStatus = reap.status;
    } else {
      creation = runScratchLifecycle('create', runId, command.scratchSubtype, environment);
      if (creation.status !== 0) {
        executionStatus = creation.status;
      } else {
        created = true;

        const testEnvironment = {
          ...environment,
          QURAN_DASHBOARD_TEST_RUN_ID: runId,
          QURAN_DASHBOARD_TEST_LOCK_COMMAND: SCRATCH_LOCK_COMMAND,
          QURAN_DASHBOARD_TEST_SCRATCH_SUBTYPE: command.scratchSubtype,
        };
        const testStartedAt = performance.now();
        testStatus = executeCommand(command, testEnvironment);
        testDurationMilliseconds = performance.now() - testStartedAt;
        executionStatus = testStatus;
      }
    }
  } finally {
    if (created) {
      cleanup = runScratchLifecycle('cleanup', runId, command.scratchSubtype, environment);
    }
    keeper.stdin.end();
    keeperExitStatus = await waitForExit(keeper);
  }

  let finalStatus = cleanup !== null && cleanup.status !== 0
    ? cleanup.status
    : executionStatus;
  if (keeperExitStatus !== 0 && finalStatus === 0) {
    finalStatus = keeperExitStatus ?? 1;
  }
  console.log(JSON.stringify(createEmptyScratchExecutionEvidence({
    command,
    runId,
    keeperStatus: 'acquired',
    keeperExitStatus,
    keeperDurationMilliseconds,
    reap,
    create: creation,
    testStatus,
    testDurationMilliseconds,
    cleanup,
    totalDurationMilliseconds: performance.now() - totalStartedAt,
    finalStatus,
  })));
  return commandOutcome(finalStatus, { lockWaitMilliseconds });
}

async function executeFullRehearsal(command, environment = process.env) {
  if (!['phrase-search-index-build', 'recovery'].includes(command.rehearsalSubtype)) {
    console.error(
      `[scripts/test] ${command.id} is not an index/recovery full-data rehearsal supported by this explicit capability.`,
    );
    return commandOutcome(2);
  }

  const runId = createScratchRunId();
  const keeperStartedAt = performance.now();
  const acquisition = await startFullRehearsalKeeper(runId, command.rehearsalSubtype, environment);
  const keeperDurationMilliseconds = performance.now() - keeperStartedAt;
  // `rehearsal hold` recomputes the Protected State fingerprint and verifies the subtype, provenance,
  // migration, and freshness markers of a manually provisioned database before it takes the lock. That
  // validation is provisioning time; the advisory wait inside it is lock contention.
  const lockWaitMilliseconds = acquisition?.lockWaitMilliseconds ?? 0;
  const capabilityMilliseconds = Math.max(0, keeperDurationMilliseconds - lockWaitMilliseconds);
  const keeper = acquisition?.keeper;
  if (!keeper) {
    return commandOutcome(3, { lockWaitMilliseconds, capabilityMilliseconds });
  }

  let commandStatus = 1;
  try {
    const testEnvironment = {
      ...environment,
      QURAN_DASHBOARD_TEST_RUN_ID: runId,
      QURAN_DASHBOARD_TEST_LOCK_COMMAND: FULL_REHEARSAL_LOCK_COMMAND,
      QURAN_DASHBOARD_TEST_FULL_REHEARSAL_SUBTYPE: command.rehearsalSubtype,
    };
    commandStatus = executeCommand(command, testEnvironment);
  } finally {
    // Full Rehearsal Databases are manually provisioned capabilities. Success and failure both
    // preserve the database; only `TestRuntime rehearsal cleanup apply` may remove it.
    keeper.stdin.end();
    await waitForExit(keeper);
  }
  return commandOutcome(commandStatus, { lockWaitMilliseconds, capabilityMilliseconds });
}

function runScratchLifecycle(action, runId, subtype = null, environment = process.env) {
  const startedAt = performance.now();
  const arguments_ = [
    TEST_RUNTIME_ASSEMBLY,
    'scratch',
    action,
    '--run-id',
    runId,
    '--command',
    SCRATCH_LOCK_COMMAND,
  ];
  if (action === 'create' && subtype !== null) {
    arguments_.push('--subtype', subtype);
  }
  const result = spawnSync('dotnet', arguments_, {
    cwd: REPOSITORY_ROOT,
    env: environment,
    encoding: 'utf8',
  });
  if (result.stdout) {
    process.stdout.write(result.stdout);
  }
  if (result.stderr) {
    process.stderr.write(result.stderr);
  }
  if (result.error) {
    console.error(`[scripts/test] scratch ${action} could not start: ${result.error.message}`);
    return assessScratchLifecycleResult({
      action,
      runId,
      subtype,
      processStatus: result.status,
      report: null,
      durationMilliseconds: performance.now() - startedAt,
      processError: true,
    });
  }
  let report = null;
  let parseError = false;
  try {
    report = result.stdout ? JSON.parse(result.stdout) : null;
  } catch {
    parseError = true;
    console.error(`[scripts/test] scratch ${action} returned invalid JSON evidence.`);
  }
  if (!result.stdout) {
    console.error(`[scripts/test] scratch ${action} returned no JSON evidence.`);
  }
  return assessScratchLifecycleResult({
    action,
    runId,
    subtype,
    processStatus: result.status,
    report,
    durationMilliseconds: performance.now() - startedAt,
    parseError,
  });
}

async function startScratchKeeper(runId, environment = process.env) {
  const keeper = spawn('dotnet', [
    TEST_RUNTIME_ASSEMBLY,
    'lock',
    'hold',
    '--mode',
    'exclusive',
    '--run-id',
    runId,
    '--command',
    SCRATCH_LOCK_COMMAND,
    '--release-on-stdin-close',
  ], {
    cwd: REPOSITORY_ROOT,
    env: environment,
    stdio: ['pipe', 'pipe', 'pipe'],
  });
  keeper.stderr.pipe(process.stderr);

  const firstLine = await readFirstLine(keeper.stdout, keeper);
  if (firstLine === null) {
    await waitForExit(keeper);
    return null;
  }
  process.stdout.write(`${firstLine}\n`);
  let report;
  try {
    report = JSON.parse(firstLine);
  } catch {
    keeper.stdin.end();
    await waitForExit(keeper);
    console.error('[scripts/test] TestRuntime keeper returned invalid JSON.');
    return null;
  }
  if (!report.succeeded || report.advisoryLock?.status !== 'acquired') {
    keeper.stdin.end();
    await waitForExit(keeper);
    return null;
  }

  keeper.stdout.pipe(process.stdout);
  return { keeper, lockWaitMilliseconds: report.advisoryLock?.waitMilliseconds ?? 0 };
}

async function startFullRehearsalKeeper(runId, subtype, environment = process.env) {
  const keeper = spawn('dotnet', [
    TEST_RUNTIME_ASSEMBLY,
    'rehearsal',
    'hold',
    '--subtype',
    subtype,
    '--run-id',
    runId,
    '--command',
    FULL_REHEARSAL_LOCK_COMMAND,
    '--release-on-stdin-close',
  ], {
    cwd: REPOSITORY_ROOT,
    env: environment,
    stdio: ['pipe', 'pipe', 'pipe'],
  });
  keeper.stderr.pipe(process.stderr);

  const firstLine = await readFirstLine(keeper.stdout, keeper);
  if (firstLine === null) {
    await waitForExit(keeper);
    return null;
  }
  process.stdout.write(`${firstLine}\n`);
  let report;
  try {
    report = JSON.parse(firstLine);
  } catch {
    keeper.stdin.end();
    await waitForExit(keeper);
    console.error('[scripts/test] full Rehearsal Database validation returned invalid JSON.');
    return null;
  }
  if (!report.succeeded
      || report.fullRehearsal?.capabilityState !== 'ready'
      || report.advisoryLock?.status !== 'acquired') {
    keeper.stdin.end();
    await waitForExit(keeper);
    reportUnavailableFullRehearsal(subtype, report);
    return null;
  }

  keeper.stdout.pipe(process.stdout);
  return { keeper, lockWaitMilliseconds: report.advisoryLock?.waitMilliseconds ?? 0 };
}

// The full Rehearsal Database is a manually provisioned capability. When it is absent or stale the
// selected lane must fail on its own with enough detail to provision it -- never by silently degrading
// or by rebuilding a database the runner does not own.
function reportUnavailableFullRehearsal(subtype, report) {
  const capabilityState = report.fullRehearsal?.capabilityState ?? 'unavailable';
  console.error(
    `[scripts/test] the ${subtype} full Rehearsal Database is not usable (capabilityState=${capabilityState}).`,
  );
  if (report.advisoryLock?.status && report.advisoryLock.status !== 'acquired') {
    console.error(`[scripts/test]   advisory lock: ${report.advisoryLock.status}`);
  }
  for (const violation of report.violations ?? []) {
    console.error(`[scripts/test]   violation: ${violation.code ?? violation}`);
  }
  for (const guidance of report.fullRehearsal?.guidance ?? []) {
    console.error(`[scripts/test]   ${guidance}`);
  }
  console.error(
    '[scripts/test] Provision or refresh it manually, then rerun this lane with --authorize-full-data.',
  );
  console.error('[scripts/test] Only this lane failed; no other selection was affected.');
}

function readFirstLine(stream, child) {
  return new Promise((resolveLine) => {
    let buffered = '';
    const onData = (chunk) => {
      buffered += chunk.toString();
      const newline = buffered.indexOf('\n');
      if (newline >= 0) {
        cleanup();
        resolveLine(buffered.slice(0, newline));
      }
    };
    const onClose = () => {
      cleanup();
      resolveLine(buffered.length > 0 ? buffered : null);
    };
    const cleanup = () => {
      stream.off('data', onData);
      child.off('close', onClose);
    };
    stream.on('data', onData);
    child.on('close', onClose);
  });
}

function waitForExit(child) {
  if (child.exitCode !== null) {
    return Promise.resolve(child.exitCode);
  }
  return new Promise((resolveExit) => child.once('close', (code) => resolveExit(code ?? 1)));
}

function createScratchRunId() {
  return randomBytes(16).toString('hex');
}

function isBackendTestDelegate(command) {
  return command.executable === 'Backend/scripts/test-backend'
    || command.executable.endsWith('/test-backend');
}

function backendResultsDirectory(command) {
  return join(evidenceDirectory, command.id.replace(/[^A-Za-z0-9._-]+/g, '_'));
}

function collectTrxTestCases(command, path) {
  if (!isBackendTestDelegate(command)) {
    return;
  }

  let files;
  try {
    files = readdirSync(backendResultsDirectory(command)).filter((name) => name.endsWith('.trx'));
  } catch {
    return;
  }

  for (const file of files) {
    const trx = readFileSync(join(backendResultsDirectory(command), file), 'utf8');
    for (const match of trx.matchAll(/<UnitTestResult\b([^>]*)\/?>/g)) {
      const outcome = /outcome="([^"]*)"/.exec(match[1])?.[1];
      if (outcome !== 'Passed' && outcome !== 'Failed') {
        continue;
      }
      const testName = decodeTrxAttribute(/testName="([^"]*)"/.exec(match[1])?.[1]);
      if (!testName) {
        continue;
      }
      try {
        appendFileSync(path, `${JSON.stringify({ event: 'testCase', id: testName, commandId: command.id })}\n`);
      } catch {
        // Telemetry must never change the command verdict.
      }
    }
  }
}

function decodeTrxAttribute(value) {
  if (!value) {
    return value;
  }
  return value
    .replaceAll('&quot;', '"')
    .replaceAll('&apos;', "'")
    .replaceAll('&lt;', '<')
    .replaceAll('&gt;', '>')
    .replaceAll('&amp;', '&');
}

function resolvePlaywrightSelections(selectors) {
  if (selectors.length === 0) {
    return [];
  }

  const discovery = spawnSync('npm', ['run', '--silent', 'e2e:discover:policies'], {
    cwd: FRONTEND_ROOT,
    encoding: 'utf8',
    env: process.env,
  });
  if (discovery.error || discovery.status !== 0) {
    throw new Error(
      `Playwright policy discovery failed:\n${discovery.error?.message ?? discovery.stderr ?? discovery.stdout}`,
    );
  }

  let tests;
  try {
    tests = JSON.parse(discovery.stdout);
  } catch (error) {
    throw new Error(`Playwright policy discovery returned invalid JSON: ${error.message}`);
  }

  return selectors.map((selector) => {
    const match = /^(.*\.e2e\.ts):([1-9][0-9]*)$/.exec(selector);
    if (!match) {
      throw new Error(`Playwright selector must be an exact file:line: ${selector}`);
    }
    const normalizedFile = match[1].startsWith('e2e/') ? match[1] : `e2e/${match[1]}`;
    const line = Number(match[2]);
    const matches = tests.filter((test) => test.file === normalizedFile && test.line === line);
    if (matches.length === 0) {
      throw new Error(`Unknown Playwright file:line selector: ${selector}`);
    }
    const groups = new Set(matches.map(({ effectiveGroup }) => effectiveGroup));
    if (groups.size !== 1) {
      throw new Error(`Playwright selector has contradictory project policies: ${selector}`);
    }
    return { file: normalizedFile, line, effectiveGroup: matches[0].effectiveGroup };
  });
}

function parseArguments(arguments_) {
  const mode = arguments_[0];
  if (!['focused', 'pre-pr'].includes(mode)) {
    throw new Error('The first argument must be focused or pre-pr.');
  }
  const parsed = {
    mode,
    backendClasses: [],
    backendMethods: [],
    playwrightSelectors: [],
    affectedFeatures: [],
    affectedConcerns: [],
    authorizeFullData: false,
    buildMode: '',
    dryRun: false,
    explicitPolicy: null,
  };

  for (let index = 1; index < arguments_.length; index += 1) {
    const argument = arguments_[index];
    if (argument === '--backend-class') {
      requireMode(mode, 'focused', argument);
      parsed.backendClasses.push(requireValue(arguments_, ++index, argument));
    } else if (argument === '--backend-test') {
      requireMode(mode, 'focused', argument);
      parsed.backendMethods.push(requireValue(arguments_, ++index, argument));
    } else if (argument === '--playwright') {
      requireMode(mode, 'focused', argument);
      parsed.playwrightSelectors.push(requireValue(arguments_, ++index, argument));
    } else if (argument === '--feature') {
      requireMode(mode, 'pre-pr', argument);
      parsed.affectedFeatures.push(requireValue(arguments_, ++index, argument));
    } else if (argument === '--concern') {
      requireMode(mode, 'pre-pr', argument);
      parsed.affectedConcerns.push(requireValue(arguments_, ++index, argument));
    } else if (argument === '--authorize-full-data') {
      parsed.authorizeFullData = true;
    } else if (argument === '--policy') {
      requireMode(mode, 'pre-pr', argument);
      if (parsed.explicitPolicy !== null) {
        throw new Error('Choose at most one explicit scheduled/release policy.');
      }
      parsed.explicitPolicy = requireValue(arguments_, ++index, argument);
    } else if (argument === '--build' || argument === '--no-build') {
      requireMode(mode, 'focused', argument);
      if (parsed.buildMode) {
        throw new Error('Choose exactly one of --build or --no-build.');
      }
      parsed.buildMode = argument === '--build' ? 'build' : 'no-build';
    } else if (argument === '--dry-run') {
      parsed.dryRun = true;
    } else if (argument === '--help' || argument === '-h') {
      printUsage();
      process.exit(0);
    } else {
      throw new Error(`Unknown argument: ${argument}`);
    }
  }

  if (mode === 'focused' && !parsed.buildMode) {
    throw new Error('Focused mode requires exactly one of --build or --no-build.');
  }
  return parsed;
}

function requireMode(actual, expected, option) {
  if (actual !== expected) {
    throw new Error(`${option} is valid only in ${expected} mode.`);
  }
}

function requireValue(arguments_, index, option) {
  const value = arguments_[index];
  if (!value || value.startsWith('--')) {
    throw new Error(`${option} requires a value.`);
  }
  return value;
}

function printUsage() {
  console.log(`Usage:
  scripts/test focused (--backend-class CLASS | --backend-test METHOD | --playwright FILE:LINE)... --build|--no-build [--authorize-full-data] [--dry-run]
  scripts/test pre-pr [--feature FEATURE] [--concern CONCERN] [--policy scheduled|release] [--authorize-full-data] [--dry-run]`);
}
