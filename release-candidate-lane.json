{
  "schemaVersion": 1,
  "id": "release-candidate",
  "title": "Release candidate lane",
  "providerNeutral": true,
  "timeoutSeconds": 43200,
  "artifact": {
    "id": "quran-canonical",
    "sha256": "3d4038d561a2b4b048e72c05f0cc472b2b1bcf0f2af0d09d0c054cff38e9b29d"
  },
  "previousRelease": {
    "reference": "df07306b5a5ebe08ff205c0d2f6cd5a10af87f2d"
  },
  "externalEvidence": {
    "maxAgeHours": 24,
    "documents": [
      "isolated-staging-critical-journeys",
      "real-logto-sentinel",
      "manual-release-charter"
    ]
  },
  "commands": [
    {
      "id": "locked-backend-restore",
      "timeoutSeconds": 1800,
      "cwd": ".",
      "executable": "dotnet",
      "arguments": ["restore", "Backend/QuranDashboard.sln", "--locked-mode", "--disable-parallel", "-m:1", "-p:BuildInParallel=false", "-p:RestoreDisableParallel=true"]
    },
    {
      "id": "no-restore-backend-build",
      "timeoutSeconds": 1800,
      "cwd": ".",
      "executable": "dotnet",
      "arguments": ["build", "Backend/QuranDashboard.sln", "--no-restore", "-m:1", "-p:BuildInParallel=false"],
      "dependsOn": ["locked-backend-restore"]
    },
    {
      "id": "verify-full-canonical-artifact",
      "timeoutSeconds": 900,
      "cwd": ".",
      "executable": "Backend/scripts/test-artifacts",
      "arguments": ["verify-content-addressed", "--artifact", "quran-canonical"],
      "dependsOn": ["no-restore-backend-build"]
    },
    {
      "id": "previous-release-upgrade",
      "timeoutSeconds": 7200,
      "cwd": ".",
      "executable": "Backend/scripts/test-backend",
      "arguments": ["previous-release-upgrade", "--no-build", "--results-dir", "{RELEASE_RESULTS_DIR}/previous-release-upgrade"],
      "dependsOn": ["verify-full-canonical-artifact"],
      "databaseOwning": true
    },
    {
      "id": "full-canonical-recovery",
      "timeoutSeconds": 7200,
      "cwd": ".",
      "executable": "Backend/scripts/test-backend",
      "arguments": ["full-canonical-recovery", "--no-build", "--results-dir", "{RELEASE_RESULTS_DIR}/full-canonical-recovery"],
      "dependsOn": ["verify-full-canonical-artifact"],
      "databaseOwning": true
    },
    {
      "id": "release-dependency-advisory",
      "timeoutSeconds": 3600,
      "cwd": ".",
      "executable": "node",
      "arguments": ["scripts/run-dependency-advisory-evaluation.mjs", "--trigger", "release", "--results-dir", "{RELEASE_RESULTS_DIR}/dependency-advisory"]
    }
  ]
}
