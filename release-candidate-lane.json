{
  "schemaVersion": 2,
  "id": "release-candidate",
  "title": "Local-first pre-merge verification",
  "executionScope": "local-first-pre-merge",
  "providerNeutral": true,
  "timeoutSeconds": 43200,
  "commands": [
    {
      "id": "locked-backend-restore",
      "timeoutSeconds": 1800,
      "cwd": ".",
      "executable": "dotnet",
      "arguments": ["restore", "Backend/QuranDashboard.sln", "--locked-mode", "--disable-parallel", "-m:1", "-p:BuildInParallel=false", "-p:RestoreDisableParallel=true"]
    },
    {
      "id": "no-restore-backend-build",
      "timeoutSeconds": 1800,
      "cwd": ".",
      "executable": "dotnet",
      "arguments": ["build", "Backend/QuranDashboard.sln", "--no-restore", "-m:1", "-p:BuildInParallel=false"],
      "dependsOn": ["locked-backend-restore"]
    },
    {
      "id": "inspect-test-runtime",
      "timeoutSeconds": 900,
      "cwd": ".",
      "executable": "dotnet",
      "arguments": ["Backend/tools/QuranDashboard.TestRuntime/bin/Debug/net10.0/QuranDashboard.TestRuntime.dll", "inspect"],
      "dependsOn": ["no-restore-backend-build"]
    },
    {
      "id": "release-dependency-advisory",
      "timeoutSeconds": 3600,
      "cwd": ".",
      "executable": "node",
      "arguments": ["scripts/run-dependency-advisory-evaluation.mjs", "--trigger", "release", "--results-dir", "{RELEASE_RESULTS_DIR}/dependency-advisory"]
    }
  ]
}
