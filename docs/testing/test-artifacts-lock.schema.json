{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quran-dashboard.local/schemas/test-artifacts-lock.schema.json",
  "title": "Quran Dashboard test artifact lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "contractVersion", "artifacts"],
  "properties": {
    "$schema": {
      "const": "docs/testing/test-artifacts-lock.schema.json"
    },
    "contractVersion": {
      "const": 1
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "token": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{0,99}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$"
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["head", "count"],
      "properties": {
        "head": {
          "type": "string",
          "pattern": "^[0-9]{14}_[A-Za-z0-9_]+$"
        },
        "count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "version"],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "$ref": "#/$defs/version"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "sha256", "provenance"],
      "properties": {
        "id": {
          "$ref": "#/$defs/token"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "provenance": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sentinel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "expectedCount", "oracleSha256"],
      "properties": {
        "id": {
          "$ref": "#/$defs/token"
        },
        "expectedCount": {
          "type": "integer",
          "minimum": 0
        },
        "oracleSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "requiredLanes",
        "stagedFiles",
        "manifestPath",
        "migration",
        "tableScope",
        "postgresql",
        "producer",
        "sources",
        "sentinels",
        "immutableStorageId",
        "refresh"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/token"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "requiredLanes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/token"
          }
        },
        "stagedFiles": {
          "type": "array",
          "minItems": 2,
          "allOf": [
            {
              "contains": {
                "type": "object",
                "required": ["role"],
                "properties": {
                  "role": { "const": "manifest" }
                }
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "required": ["role"],
                "properties": {
                  "role": { "const": "payload" }
                }
              },
              "minContains": 1
            }
          ],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "role", "size", "sha256"],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "enum": ["manifest", "oracle", "payload"]
              },
              "size": {
                "type": "integer",
                "minimum": 0
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        },
        "manifestPath": {
          "type": "string",
          "minLength": 1
        },
        "migration": {
          "$ref": "#/$defs/migration"
        },
        "tableScope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["quran", "phraseSearch", "abwab", "access", "linking", "tables"],
          "properties": {
            "quran": { "type": "boolean" },
            "phraseSearch": { "type": "boolean" },
            "abwab": { "type": "boolean" },
            "access": { "type": "boolean" },
            "linking": { "type": "boolean" },
            "tables": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,62}$"
              }
            }
          }
        },
        "postgresql": {
          "type": "object",
          "additionalProperties": false,
          "required": ["producerVersion", "containerDigest"],
          "properties": {
            "producerVersion": {
              "type": "string",
              "minLength": 1
            },
            "containerDigest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        },
        "producer": {
          "$ref": "#/$defs/producer"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "sentinels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sentinel"
          }
        },
        "immutableStorageId": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^?#\\s]+@(sha256:[0-9a-f]{64}|version:[A-Za-z0-9][A-Za-z0-9._-]{0,99})$"
        },
        "refresh": {
          "type": "object",
          "additionalProperties": false,
          "required": ["date", "reason", "ownerRole"],
          "properties": {
            "date": {
              "type": "string",
              "format": "date"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "ownerRole": {
              "$ref": "#/$defs/token"
            }
          }
        },
        "phraseSearch": {
          "type": "object",
          "additionalProperties": false,
          "required": ["manifestSha256", "sourceFingerprint", "readinessExpectation"],
          "properties": {
            "manifestSha256": {
              "$ref": "#/$defs/sha256"
            },
            "sourceFingerprint": {
              "type": "string",
              "minLength": 1
            },
            "readinessExpectation": {
              "enum": ["available", "unavailable"]
            }
          }
        }
      }
    }
  }
}
