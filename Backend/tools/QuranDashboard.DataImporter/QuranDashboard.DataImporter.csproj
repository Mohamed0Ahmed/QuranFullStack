<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>9b57d4a2-68cf-421c-9970-b3a323c1e927</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="QuranDashboard.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\application\QuranDashboard.Application\QuranDashboard.Application.csproj" />
    <ProjectReference Include="..\..\application\QuranDashboard.Application.Abstractions\QuranDashboard.Application.Abstractions.csproj" />
    <ProjectReference Include="..\..\infrastructure\QuranDashboard.Infrastructure\QuranDashboard.Infrastructure.csproj" />
    <ProjectReference Include="..\..\shared\QuranDashboard.Shared\QuranDashboard.Shared.csproj" />
    <ProjectReference Include="..\QuranDashboard.TestRuntime\QuranDashboard.TestRuntime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\testing\test-database-contract.json"
          Link="test-database-contract.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
