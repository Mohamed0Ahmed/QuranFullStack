{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "QuranDashboardDb": "Host=localhost;Port=5432;Database=quran_dashboard;Username=postgres;Password=SET_VIA_USER_SECRETS"
  },
  "Cors": {
    "AllowedOrigins": [
      "https://localhost:4200"
    ]
  },
  "MushafReader": {
    "DefaultTafsirSourceKey": "ar-muyassar",
    "DefaultTranslationSourceKey": "en-sahih-international",
    "DefaultFullI3rabSourceKey": "muyassar"
  },
  "LinkingScalability": {
    "PageSizeMaximum": 100,
    "CompactSourceCacheBudgetReferences": 60000,
    "AyahTextCacheBudgetReferences": 60000,
    "CacheSlidingExpiration": "00:30:00",
    "CacheAbsoluteExpiration": "04:00:00",
    "PreflightProcessorConcurrency": 2,
    "ConfirmationProcessorConcurrency": 2,
    "ActiveWorkflowsPerActor": 4,
    "PersistenceBatchSize": 500,
    "WorkerLease": "00:02:00",
    "WorkerHeartbeat": "00:00:30",
    "MaximumAutomaticAttempts": 3,
    "PollAfterMilliseconds": 1500,
    "ReadyPreflightLifetime": "00:30:00",
    "AbandonedPreflightLifetime": "02:00:00",
    "TerminalRetention": "24:00:00",
    "CleanupInterval": "00:05:00"
  },
  "RateLimiting": {
    "Enabled": false,
    "ClientIpHeaderName": "X-Real-IP",
    "TokenLimit": 30,
    "TokensPerPeriod": 30,
    "ReplenishmentPeriodSeconds": 15,
    "QueueLimit": 0,
    "HealthPermitLimit": 300,
    "HealthWindowSeconds": 60,
    "PhraseSearchComputePermitLimit": 4,
    "PhraseSearchComputeQueueLimit": 8,
    "PhraseSearchComputeTimeoutSeconds": 10
  },
  "Auth": {
    "Authority": "https://REPLACE-WITH-YOUR-TENANT.logto.app/oidc",
    "Audience": "https://REPLACE-WITH-YOUR-API-RESOURCE-INDICATOR",
    "InteractiveClientId": "REPLACE-WITH-YOUR-LOGTO-SPA-APP-ID",
    "ManagementApi": {
      "Endpoint": "https://REPLACE-WITH-YOUR-TENANT.logto.app",
      "Resource": "https://REPLACE-WITH-YOUR-TENANT-ID.logto.app/api",
      "AppId": "",
      "AppSecret": ""
    }
  },
  "OwnerBootstrap": {
    "Emails": []
  },
  "AllowedHosts": "*"
}
