#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BACKEND_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
REPO_ROOT="$(cd "${BACKEND_ROOT}/.." && pwd)"

DUMP_NAME="quran-canonical"
DUMP_DIR="${REPO_ROOT}/resources/db-dumps/${DUMP_NAME}"
DUMP_FILE="${DUMP_DIR}/${DUMP_NAME}.dump"
MANIFEST_FILE="${DUMP_DIR}/manifest.json"
MIGRATIONS_DIR="${BACKEND_ROOT}/infrastructure/QuranDashboard.Infrastructure/Migrations"
API_PROJECT="${BACKEND_ROOT}/api/QuranDashboard.Api"

# The canonical state this dump is only ever allowed to capture. These are not defaults to be
# refreshed when the local database drifts: a mismatch means the database is not canonical, and
# dumping it would hand the smoke data tier baselines that silently disagree with the manifest.
BASELINE_TABLES=(quran_roots quran_lemmas quran_stems quran_word_morphology quran_word_morphology_segments)
BASELINE_COUNTS=(1642 4817 11843 77432 128219)

usage() {
  echo "Usage: ./scripts/create-smoke-dump --yes [--allow-remote]" >&2
}

fail() {
  echo "ERROR: $*" >&2
  exit 1
}

CONFIRMED=false
ALLOW_REMOTE=false
for arg in "$@"; do
  case "${arg}" in
    --yes) CONFIRMED=true ;;
    --allow-remote) ALLOW_REMOTE=true ;;
    *)
      echo "ERROR: unknown argument '${arg}'." >&2
      usage
      exit 1
      ;;
  esac
done

# shellcheck source=_preflight-sandbox.sh
source "${SCRIPT_DIR}/_preflight-sandbox.sh"
preflight_check_stale_sandbox_assets "${BACKEND_ROOT}"

# 1. Connection string: the environment override first, then user secrets. The secrets listing
# carries every secret this project holds, so it is captured into a variable and never echoed.
resolve_connection_string() {
  if [[ -n "${ConnectionStrings__QuranDashboardDb:-}" ]]; then
    printf '%s' "${ConnectionStrings__QuranDashboardDb}"
    return
  fi

  local secrets
  secrets="$(dotnet user-secrets list --project "${API_PROJECT}")" \
    || fail "could not read user secrets from ${API_PROJECT}. Set ConnectionStrings__QuranDashboardDb instead."
  sed -n 's/^ConnectionStrings:QuranDashboardDb = //p' <<<"${secrets}"
}

# Npgsql keyword strings are case-insensitive and tolerate spaces around the key, so both are
# normalized before comparing. Read into an array rather than iterating a split string: a password
# containing a glob character would otherwise be pathname-expanded.
connection_value() {
  local wanted="$1" conn="$2"
  local -a pairs
  local pair name
  IFS=';' read -r -a pairs <<<"${conn}"
  for pair in "${pairs[@]}"; do
    [[ "${pair}" == *=* ]] || continue
    name="$(tr -d '[:space:]' <<<"${pair%%=*}" | tr '[:upper:]' '[:lower:]')"
    if [[ "${name}" == "${wanted}" ]]; then
      printf '%s' "${pair#*=}"
      return
    fi
  done
}

CONNECTION_STRING="$(resolve_connection_string)"
[[ -n "${CONNECTION_STRING}" ]] || fail "no connection string found. Set ConnectionStrings__QuranDashboardDb or the ConnectionStrings:QuranDashboardDb user secret."

PGHOST="$(connection_value host "${CONNECTION_STRING}")"
[[ -n "${PGHOST}" ]] || PGHOST="$(connection_value server "${CONNECTION_STRING}")"
PGPORT="$(connection_value port "${CONNECTION_STRING}")"
PGDATABASE="$(connection_value database "${CONNECTION_STRING}")"
PGUSER="$(connection_value username "${CONNECTION_STRING}")"
[[ -n "${PGUSER}" ]] || PGUSER="$(connection_value userid "${CONNECTION_STRING}")"
PGPASSWORD="$(connection_value password "${CONNECTION_STRING}")"
export PGHOST PGPORT="${PGPORT:-5432}" PGDATABASE PGUSER PGPASSWORD

[[ -n "${PGHOST}" && -n "${PGDATABASE}" ]] || fail "connection string is missing a host or a database name."

# 2. Fail closed on anything but a local host. A deployed database must never be dumped by
# accident, so remoteness is opt-in and explicit rather than inferred.
if [[ "${ALLOW_REMOTE}" != true ]]; then
  case "${PGHOST}" in
    localhost | 127.0.0.1) ;;
    *) fail "refusing to dump non-local host '${PGHOST}'. Pass --allow-remote to override." ;;
  esac
fi

# 3. The dump is a third of a gigabyte and this replaces it outright, so say so and stop.
if [[ "${CONFIRMED}" != true ]]; then
  echo "WARNING: this overwrites the canonical smoke dump and its manifest." >&2
  if [[ -f "${DUMP_FILE}" ]]; then
    echo "  dump:     ${DUMP_FILE} ($(du -h "${DUMP_FILE}" | cut -f1), $(stat -c '%y' "${DUMP_FILE}" | cut -d'.' -f1))" >&2
  else
    echo "  dump:     ${DUMP_FILE} (does not exist yet)" >&2
  fi
  echo "  manifest: ${MANIFEST_FILE}" >&2
  echo "  source:   ${PGUSER}@${PGHOST}:${PGPORT}/${PGDATABASE}" >&2
  usage
  exit 1
fi

pg_query() {
  psql --no-psqlrc --quiet --no-align --tuples-only -v ON_ERROR_STOP=1 --command "$1"
}

# 4. The dump is data-only, so the schema the tier restores into comes from the migrations in this
# tree. A database that is behind or ahead of them produces data that does not fit that schema.
migration_file_count="$(find "${MIGRATIONS_DIR}" -maxdepth 1 -name '*.cs' \
  ! -name '*.Designer.cs' ! -name '*ModelSnapshot.cs' -printf '.' | wc -c)"
applied_count="$(pg_query 'SELECT count(*) FROM "__EFMigrationsHistory";')" \
  || fail "could not read __EFMigrationsHistory from ${PGDATABASE} on ${PGHOST}:${PGPORT}. Nothing dumped."
migration_id="$(pg_query 'SELECT "MigrationId" FROM "__EFMigrationsHistory" ORDER BY "MigrationId" DESC LIMIT 1;')" \
  || fail "could not read the applied migration head from ${PGDATABASE}. Nothing dumped."

if [[ "${applied_count}" != "${migration_file_count}" ]]; then
  fail "migration drift: ${applied_count} applied in ${PGDATABASE}, ${migration_file_count} migration files in the tree (head applied: ${migration_id}). Nothing dumped."
fi

# 5. Baseline counts, all five reported together so a single run shows every drift rather than the
# first one.
baseline_drift=()
for index in "${!BASELINE_TABLES[@]}"; do
  table="${BASELINE_TABLES[${index}]}"
  expected="${BASELINE_COUNTS[${index}]}"
  actual="$(pg_query "SELECT count(*) FROM public.${table};")" \
    || fail "could not count public.${table} in ${PGDATABASE}. Nothing dumped."
  if [[ "${actual}" != "${expected}" ]]; then
    baseline_drift+=("${table}: expected ${expected}, actual ${actual}")
  fi
done

if [[ ${#baseline_drift[@]} -gt 0 ]]; then
  echo "ERROR: ${PGDATABASE} is not in the canonical state. Nothing dumped." >&2
  printf '  %s\n' "${baseline_drift[@]}" >&2
  echo "Do not relax the baseline to make this pass — restore the canonical data instead." >&2
  exit 1
fi

# 6. Dump to a temp file in the destination directory. A killed pg_dump must not leave a truncated
# archive where the data tier expects a complete one, and the rename below is atomic only because the
# temp file shares the destination's filesystem.
mkdir -p "${DUMP_DIR}"
TMP_DUMP="$(mktemp "${DUMP_DIR}/.${DUMP_NAME}.dump.XXXXXX")"
trap 'rm -f "${TMP_DUMP}" "${MANIFEST_FILE}.tmp"' EXIT

echo "Dumping public.quran_* from ${PGDATABASE} (migration head ${migration_id})…"
pg_dump --format=custom --data-only --table='public.quran_*' --file="${TMP_DUMP}"

dump_sha256="$(sha256sum "${TMP_DUMP}" | cut -d' ' -f1)"

# 7. Manifest, still to a temp file: the dump and the manifest have to become visible together. The
# counts below take seconds over the largest tables, and a failure anywhere in that window would
# otherwise leave a new dump beside the old manifest — a pairing the data tier's gate rejects as
# corrupt on every subsequent run.
#
# They cover every quran_* table, not only the five guarded in step 5, because the data tier reads its
# expectations from here. Note that step 5 read its counts before pg_dump and these are read after it:
# on a database with a concurrent writer the two halves would describe different snapshots. That is
# accepted — this dumps a single-operator local database.
pg_dump_version="$(pg_dump --version | awk '{print $3}')"
table_rows="$(pg_query "
  SELECT c.relname || '|' ||
         (xpath('/row/cnt/text()', query_to_xml(
            format('SELECT count(*) AS cnt FROM public.%I', c.relname), false, true, '')))[1]::text
  FROM pg_class c
  JOIN pg_namespace n ON n.oid = c.relnamespace
  WHERE n.nspname = 'public' AND c.relkind = 'r' AND c.relname LIKE 'quran\_%'
  ORDER BY c.relname;")"

{
  printf '{\n'
  printf '  "name": "%s",\n' "${DUMP_NAME}"
  printf '  "createdUtc": "%s",\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
  printf '  "migrationId": "%s",\n' "${migration_id}"
  printf '  "migrationCount": %s,\n' "${applied_count}"
  printf '  "dumpSha256": "%s",\n' "${dump_sha256}"
  printf '  "pgDumpVersion": "%s",\n' "${pg_dump_version}"
  printf '  "tables": {\n'
  separator=''
  while IFS='|' read -r table rows; do
    [[ -n "${table}" ]] || continue
    printf '%s    "%s": %s' "${separator}" "${table}" "${rows}"
    separator=$',\n'
  done <<<"${table_rows}"
  printf '\n  }\n'
  printf '}\n'
} >"${MANIFEST_FILE}.tmp"

# 8. Both renames, back to back, with nothing between them that can fail. mktemp creates 0600, and the
# data tier's container reads the dump as its own postgres uid through a read-only bind mount, so the
# archive has to be world-readable before it is published.
chmod 644 "${TMP_DUMP}"
mv -f "${TMP_DUMP}" "${DUMP_FILE}"
mv -f "${MANIFEST_FILE}.tmp" "${MANIFEST_FILE}"
trap - EXIT

echo "Wrote ${DUMP_FILE} ($(du -h "${DUMP_FILE}" | cut -f1))"
echo "  sha256:    ${dump_sha256}"
echo "  migration: ${migration_id} (${applied_count} applied)"
echo "  manifest:  ${MANIFEST_FILE}"
