#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd -P)"
BACKEND_ROOT="${REPO_ROOT}/Backend"
SOLUTION="${BACKEND_ROOT}/QuranDashboard.sln"
TEST_PROJECT="${BACKEND_ROOT}/tests/QuranDashboard.Tests/QuranDashboard.Tests.csproj"
CATALOG="${BACKEND_ROOT}/tests/QuranDashboard.Tests/TestSupport/Execution/test-gates.tsv"
TEST_OUTPUT="${BACKEND_ROOT}/tests/QuranDashboard.Tests/bin/Debug/net10.0/QuranDashboard.Tests.dll"
ACCESS_ADMIN_OUTPUT="${BACKEND_ROOT}/tools/QuranDashboard.AccessAdmin/bin/Debug/net10.0/QuranDashboard.AccessAdmin.dll"
DATA_IMPORTER_OUTPUT="${BACKEND_ROOT}/tools/QuranDashboard.DataImporter/bin/Debug/net10.0/QuranDashboard.DataImporter.dll"
TEST_RUNTIME_OUTPUT="${BACKEND_ROOT}/tools/QuranDashboard.TestRuntime/bin/Debug/net10.0/QuranDashboard.TestRuntime.dll"
ROOT_TEST_RUNNER="${REPO_ROOT}/scripts/test"
CALLER_DIR="$(pwd -P)"

usage() {
  cat <<'EOF'
Usage:
  Backend/scripts/test-backend feature --class FULL_CLASS_NAME --build|--no-build
    [--list-tests] [--results-dir PATH]
  Backend/scripts/test-backend feature --test FULL_METHOD_NAME --build|--no-build
    [--list-tests] [--results-dir PATH]
  Backend/scripts/test-backend pre-pr [--results-dir PATH]
  Backend/scripts/test-backend pre-pr --list-tests --no-build [--results-dir PATH]
EOF
}

fail_usage() {
  echo "ERROR: $1" >&2
  usage >&2
  exit 2
}

require_value() {
  local option="$1"
  local value="${2:-}"

  if [[ -z "${value}" || "${value}" == --* ]]; then
    fail_usage "${option} requires a value."
  fi
}

if [[ $# -eq 0 ]]; then
  fail_usage "A test lane is required."
fi

if [[ "$1" == "--help" || "$1" == "-h" ]]; then
  usage
  exit 0
fi

lane="$1"
shift

case "${lane}" in
  feature|pre-pr)
    ;;
  *)
    fail_usage "Unknown lane: ${lane}. Use feature or pre-pr; scripts/test is the authoritative selector."
    ;;
esac

class_selector=""
test_selector=""
build_mode=""
list_tests=false
results_dir=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --build)
      [[ -z "${build_mode}" ]] || fail_usage "Choose exactly one of --build or --no-build."
      build_mode="build"
      shift
      ;;
    --no-build)
      [[ -z "${build_mode}" ]] || fail_usage "Choose exactly one of --build or --no-build."
      build_mode="no-build"
      shift
      ;;
    --list-tests)
      list_tests=true
      shift
      ;;
    --results-dir)
      require_value "$1" "${2:-}"
      results_dir="$2"
      shift 2
      ;;
    --class)
      require_value "$1" "${2:-}"
      [[ "${lane}" == "feature" ]] || fail_usage "--class is valid only for the feature lane."
      [[ -z "${class_selector}" ]] || fail_usage "Only one class selector is allowed."
      class_selector="$2"
      shift 2
      ;;
    --test)
      require_value "$1" "${2:-}"
      [[ "${lane}" == "feature" ]] || fail_usage "--test is valid only for the feature lane."
      [[ -z "${test_selector}" ]] || fail_usage "Only one test selector is allowed."
      test_selector="$2"
      shift 2
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    *)
      fail_usage "Unknown argument: $1"
      ;;
  esac
done

if [[ "${lane}" == "pre-pr" ]]; then
  if [[ "${list_tests}" == true ]]; then
    [[ "${build_mode}" == "no-build" ]] \
      || fail_usage "pre-pr discovery requires --list-tests --no-build."
    exec node "${ROOT_TEST_RUNNER}" pre-pr --dry-run
  fi
  [[ -z "${build_mode}" || "${build_mode}" == "build" ]] \
    || fail_usage "Executing pre-pr always builds once through scripts/test."
  exec node "${ROOT_TEST_RUNNER}" pre-pr
fi

[[ -n "${build_mode}" ]] || fail_usage "Focused lanes require --build or --no-build."
selector_count=0
[[ -n "${class_selector}" ]] && selector_count=$((selector_count + 1))
[[ -n "${test_selector}" ]] && selector_count=$((selector_count + 1))
[[ "${selector_count}" -eq 1 ]] \
  || fail_usage "feature requires exactly one --class or --test selector."

if [[ ! -f "${CATALOG}" ]]; then
  echo "ERROR: Backend test catalog is missing: ${CATALOG}" >&2
  exit 1
fi

catalog_header="$(head -n 1 "${CATALOG}")"
expected_header=$'FullyQualifiedClassName\tFeature\tKind\tGate\tConcerns\tBackendPolicy\tDataReads\tDataWrites\tDatabaseTarget\tDestructiveSubtype\tResourceCollection\tMigrationState'
if [[ "${catalog_header}" != "${expected_header}" ]]; then
  echo "ERROR: Backend test catalog header is invalid: ${catalog_header}" >&2
  exit 1
fi

class_name=""
feature=""
kind=""
gate=""
concerns=""
backend_policy=""
class_exists=false
test_class_exists=false

lookup_class=""
if [[ -n "${class_selector}" ]]; then
  lookup_class="${class_selector}"
elif [[ -n "${test_selector}" ]]; then
  lookup_class="$(awk -F '\t' -v method="${test_selector}" '
    NR > 1 && index(method, $1 ".") == 1 { print $1; exit }
  ' "${CATALOG}")"
fi

if [[ -n "${lookup_class}" ]]; then
  catalog_line="$(awk -F '\t' -v class_name="${lookup_class}" '$1 == class_name { print; exit }' "${CATALOG}")"
fi

if [[ -n "${catalog_line:-}" ]]; then
  class_exists=true
  class_name="$(printf '%s\n' "${catalog_line}" | awk -F '\t' '{ print $1 }')"
  feature="$(printf '%s\n' "${catalog_line}" | awk -F '\t' '{ print $2 }')"
  kind="$(printf '%s\n' "${catalog_line}" | awk -F '\t' '{ print $3 }')"
  gate="$(printf '%s\n' "${catalog_line}" | awk -F '\t' '{ print $4 }')"
  concerns="$(printf '%s\n' "${catalog_line}" | awk -F '\t' '{ print $5 }')"
  backend_policy="$(printf '%s\n' "${catalog_line}" | awk -F '\t' '{ print $6 }')"
  if [[ -n "${test_selector}" && "${test_selector}" == "${class_name}".* ]]; then
    test_class_exists=true
  fi
fi

if [[ -n "${class_selector}" && "${class_exists}" != true ]]; then
  fail_usage "Unknown test class: ${class_selector}"
fi
if [[ -n "${test_selector}" && "${test_class_exists}" != true ]]; then
  fail_usage "The method does not belong to a cataloged test class: ${test_selector}"
fi

if [[ "${build_mode}" == "build" ]]; then
  dotnet build "${SOLUTION}" \
    --disable-build-servers \
    -m:1 \
    -p:BuildInParallel=false \
    -v minimal
fi

if [[ "${build_mode}" == "no-build" ]]; then
  missing_output=false
  if [[ ! -f "${TEST_OUTPUT}" ]]; then
    echo "ERROR: --no-build requires existing output: ${TEST_OUTPUT}" >&2
    missing_output=true
  fi
  if [[ "${feature}" == "Access" && ( "${kind}" == "Migration" || "${kind}" == "Process" ) && ! -f "${ACCESS_ADMIN_OUTPUT}" ]]; then
    echo "ERROR: --no-build requires existing AccessAdmin output: ${ACCESS_ADMIN_OUTPUT}" >&2
    missing_output=true
  fi
  if { [[ "${gate}" == "Pipeline" || "${kind}" == "Canonical" ]] || [[ "${feature}" == "Abwab" && "${kind}" == "Process" ]]; } \
    && [[ ! -f "${DATA_IMPORTER_OUTPUT}" ]]; then
    echo "ERROR: --no-build requires existing DataImporter output: ${DATA_IMPORTER_OUTPUT}" >&2
    missing_output=true
  fi
  if [[ "${backend_policy}" == "CanonicalReader" || "${backend_policy}" == "GuardedReader" ]] \
    && [[ ! -f "${TEST_RUNTIME_OUTPUT}" ]]; then
    echo "ERROR: --no-build requires existing TestRuntime output: ${TEST_RUNTIME_OUTPUT}" >&2
    missing_output=true
  fi
  [[ "${missing_output}" == false ]] || exit 1
fi

if [[ "${list_tests}" == false && ( "${backend_policy}" == "CanonicalReader" || "${backend_policy}" == "GuardedReader" ) ]]; then
  if [[ -z "${ConnectionStrings__QuranDashboardTest:-}" ]]; then
    echo "ERROR: persistent readers require ConnectionStrings__QuranDashboardTest." >&2
    exit 1
  fi
  if ! dotnet "${TEST_RUNTIME_OUTPUT}" inspect; then
    echo "ERROR: persistent Test Database capability inspection failed." >&2
    exit 1
  fi
  export QURAN_DASHBOARD_TEST_RUNTIME_READER_CONTEXT=verified-v1
fi

if [[ -n "${test_selector}" ]]; then
  set +e
  discovery_output="$(
    dotnet test "${TEST_PROJECT}" \
      --no-build \
      --no-restore \
      --disable-build-servers \
      -m:1 \
      -p:BuildInParallel=false \
      --list-tests \
      -v quiet 2>&1
  )"
  discovery_status=$?
  set -e
  if [[ "${discovery_status}" -ne 0 || "${discovery_output}" == *"System.Net.Sockets.SocketException"* ]]; then
    printf '%s\n' "${discovery_output}" >&2
    echo "ERROR: VSTest discovery failed while validating the exact method." >&2
    exit 1
  fi

  test_discovered=false
  while IFS= read -r discovered_test; do
    discovered_test="${discovered_test#"${discovered_test%%[![:space:]]*}"}"
    discovered_test="${discovered_test%%(*}"
    if [[ "${discovered_test}" == "${test_selector}" ]]; then
      test_discovered=true
      break
    fi
  done <<< "${discovery_output}"

  [[ "${test_discovered}" == true ]] || fail_usage "Unknown discovered test method: ${test_selector}"
fi

if [[ -n "${results_dir}" ]]; then
  if [[ "${results_dir}" != /* ]]; then
    results_dir="${CALLER_DIR}/${results_dir}"
  fi
  mkdir -p "${results_dir}"
fi

if [[ -n "${test_selector}" ]]; then
  filter="FullyQualifiedName=${test_selector}"
else
  filter="FullyQualifiedName~${class_name}."
fi

echo "lane: ${lane}"
echo "catalog: ${CATALOG}"
echo "selected catalog rows:"
printf '  %s\t%s\t%s\t%s\t%s\n' "${class_name}" "${feature}" "${kind}" "${gate}" "${concerns}"
echo "expanded filter: ${filter}"

if [[ "${kind}" == "Canonical" ]]; then
  missing=false
  if [[ "${class_name}" == QuranDashboard.Tests.Quran.Import.* \
    || "${class_name}" == QuranDashboard.Tests.Quran.WordsDisplay.DisplayWordsRealImportIdentityLinksTests ]]; then
    if [[ ! -d "${REPO_ROOT}/resources/import-sources/quran-foundation" ]]; then
      echo "ERROR: canonical foundation source is missing." >&2
      missing=true
    fi
    if [[ ! -f "${REPO_ROOT}/resources/import-sources/masaq-corpus-aligned/masaq-search-words.dashboard-ready.json" ]]; then
      echo "ERROR: canonical MASAQ search words source is missing." >&2
      missing=true
    fi
  fi
  if [[ "${class_name}" == QuranDashboard.Tests.Quran.WordsMorphologyEnriched.EnrichedMorphologyArtifactTests \
    && ! -f "${REPO_ROOT}/resources/import-sources/quran-enriched-morphology/corpus-based-enriched-morphology.dashboard-ready.json" ]]; then
    echo "ERROR: canonical enriched morphology source is missing." >&2
    missing=true
  fi
  if [[ "${list_tests}" == false && "${missing}" == true ]]; then
    echo "canonical data tier: failed preflight" >&2
    exit 1
  fi
  if [[ "${list_tests}" == true ]]; then
    echo "canonical data tier: discovery only"
  elif [[ "${missing}" == false ]]; then
    echo "canonical data tier: selected"
  fi
else
  echo "canonical data tier: not selected"
fi

verbosity="normal"
hang_timeout="20m"
if [[ "${kind}" == "Fast" ]]; then
  verbosity="minimal"
  hang_timeout="5m"
fi

test_args=(
  test
  "${TEST_PROJECT}"
  --no-build
  --no-restore
  --disable-build-servers
  -m:1
  -p:BuildInParallel=false
  --blame-hang
  --blame-hang-dump-type
  none
  --blame-hang-timeout
  "${hang_timeout}"
  -v
  "${verbosity}"
  --filter
  "${filter}"
)

[[ "${list_tests}" == true ]] && test_args+=(--list-tests)
if [[ -n "${results_dir}" ]]; then
  test_args+=(--results-directory "${results_dir}" --logger "trx;LogFileName=backend-tests.trx")
fi

if [[ "${list_tests}" == true ]]; then
  set +e
  discovery_output="$(dotnet "${test_args[@]}" 2>&1)"
  test_status=$?
  set -e
  printf '%s\n' "${discovery_output}"

  if [[ "${test_status}" -ne 0 || "${discovery_output}" == *"System.Net.Sockets.SocketException"* ]]; then
    echo "ERROR: VSTest discovery failed." >&2
    exit 1
  fi

  declare -A discovered_class_set=()
  while IFS= read -r discovered_test; do
    discovered_test="${discovered_test#"${discovered_test%%[![:space:]]*}"}"
    [[ "${discovered_test}" == QuranDashboard.Tests.* ]] || continue
    discovered_test="${discovered_test%%(*}"
    discovered_class="${discovered_test%.*}"
    discovered_class_set["${discovered_class}"]=1
  done <<< "${discovery_output}"

  if [[ -z "${discovered_class_set[${class_name}]:-}" ]]; then
    echo "ERROR: selected catalog class discovered no tests: ${class_name}" >&2
    exit 1
  fi
  for discovered_class in "${!discovered_class_set[@]}"; do
    if [[ "${discovered_class}" != "${class_name}" ]]; then
      echo "ERROR: filter discovered a class outside the selected catalog rows: ${discovered_class}" >&2
      exit 1
    fi
  done
  exit 0
fi

set +e
dotnet "${test_args[@]}"
test_status=$?
set -e

if [[ "${kind}" == "Canonical" ]]; then
  if [[ "${test_status}" -eq 0 ]]; then
    echo "canonical data tier: ran"
  else
    echo "canonical data tier: failed" >&2
  fi
fi

if [[ -n "${results_dir}" && "${test_status}" -eq 0 ]]; then
  printf '{"schemaVersion":1,"lane":"%s","status":"passed"}\n' "${lane}" \
    > "${results_dir}/nightly-test-evidence.json"
fi

exit "${test_status}"
