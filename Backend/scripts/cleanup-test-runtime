#!/usr/bin/env bash
set -euo pipefail

OWNER_LABEL="com.qurandashboard.test.owner=backend-tests"
REPOSITORY_LABEL="com.qurandashboard.test.repository=quran-dashboard"
KIND_LABEL="com.qurandashboard.test.kind=postgresql"
HOST_PID_LABEL="com.qurandashboard.test.host-pid"
RUN_ID_LABEL="com.qurandashboard.test.run-id"
REMOVAL_TIMEOUT_SECONDS=30

usage() {
  cat <<'EOF'
Usage:
  Backend/scripts/cleanup-test-runtime --run-id RUN_ID [--dry-run]

Removes only Docker resources carrying all five project test labels and the exact run ID.
It never prunes, never touches unlabelled resources, and never removes development volumes.
EOF
}

fail_usage() {
  echo "ERROR: $1" >&2
  usage >&2
  exit 2
}

run_id=""
dry_run=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --run-id)
      [[ -n "${2:-}" && "$2" != --* ]] || fail_usage "--run-id requires a value."
      run_id="$2"
      shift 2
      ;;
    --dry-run)
      dry_run=true
      shift
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    *)
      fail_usage "Unknown argument: $1"
      ;;
  esac
done

if [[ -z "${run_id}" ]]; then
  fail_usage "A run ID is required; cleanup never selects resources without one."
fi

if [[ ! "${run_id}" =~ ^[0-9a-f]{32}$ ]]; then
  fail_usage "A run ID must be 32 lowercase hexadecimal characters, found: ${run_id}"
fi

if ! command -v docker >/dev/null 2>&1; then
  echo "cleanup: docker is not installed; no project test resources can exist."
  exit 0
fi

if ! docker info >/dev/null 2>&1; then
  echo "cleanup: the Docker daemon is unreachable; no resources were inspected." >&2
  exit 0
fi

label_filters=(
  --filter "label=${OWNER_LABEL}"
  --filter "label=${REPOSITORY_LABEL}"
  --filter "label=${KIND_LABEL}"
  --filter "label=${HOST_PID_LABEL}"
  --filter "label=${RUN_ID_LABEL}=${run_id}"
)

mapfile -t containers < <(docker ps -aq "${label_filters[@]}")
mapfile -t networks < <(
  docker network ls -q \
    --filter "label=${OWNER_LABEL}" \
    --filter "label=${REPOSITORY_LABEL}" \
    --filter "label=${RUN_ID_LABEL}=${run_id}"
)

echo "cleanup run ID: ${run_id}"

if [[ "${#containers[@]}" -eq 0 ]]; then
  echo "cleanup containers: none"
else
  echo "cleanup containers:"
  docker ps -a --no-trunc --format '  {{.ID}}  {{.Image}}  {{.Status}}  {{.Names}}' "${label_filters[@]}"
fi

if [[ "${#networks[@]}" -eq 0 ]]; then
  echo "cleanup networks: none"
else
  echo "cleanup networks:"
  printf '  %s\n' "${networks[@]}"
fi

mapfile -t reaper < <(docker ps -q --filter "label=org.testcontainers.ryuk=true")
if [[ "${#reaper[@]}" -eq 0 ]]; then
  echo "resource reaper: not running"
else
  echo "resource reaper: ${#reaper[@]} container(s), left untouched"
fi

if [[ "${dry_run}" == true ]]; then
  echo "cleanup: dry run, nothing was removed."
  exit 0
fi

await_container_gone() {
  local container="$1"
  local waited=0

  while [[ "${waited}" -lt "${REMOVAL_TIMEOUT_SECONDS}" ]]; do
    docker container inspect "${container}" >/dev/null 2>&1 || return 0
    sleep 1
    waited=$((waited + 1))
  done

  return 1
}

# The test host removes its own containers first, through PostgreSqlTestProcess's AppDomain.ProcessExit
# handler, and the daemon reports a removal it is already performing as an error. Gone is what this script
# is for, so a container proven gone counts as cleaned; anything still present after the wait is a failure
# and keeps the daemon's own message.
remove_container() {
  local container="$1"
  local failure

  if failure="$(docker rm --force --volumes "${container}" 2>&1 >/dev/null)"; then
    removal_outcome="removed"
    return 0
  fi

  if [[ "${failure}" == *"is already in progress"* || "${failure}" == *"No such container"* ]] \
    && await_container_gone "${container}"; then
    removal_outcome="already-removed"
    return 0
  fi

  printf '%s\n' "${failure}" >&2
  removal_outcome="failed"
  return 1
}

cleanup_status=0
removed_containers=0
already_removed_containers=0
removed_networks=0
removal_outcome=""

for container in "${containers[@]}"; do
  if remove_container "${container}"; then
    if [[ "${removal_outcome}" == "removed" ]]; then
      removed_containers=$((removed_containers + 1))
    else
      already_removed_containers=$((already_removed_containers + 1))
      echo "cleanup: container ${container} was already removed by its test host."
    fi
  else
    echo "ERROR: removing container ${container} failed." >&2
    cleanup_status=1
  fi
done

for network in "${networks[@]}"; do
  if docker network rm "${network}" >/dev/null; then
    removed_networks=$((removed_networks + 1))
  else
    echo "ERROR: removing network ${network} failed." >&2
    cleanup_status=1
  fi
done

printf 'cleanup: removed %d container(s) and %d network(s); %d container(s) were already removed by their test host.\n' \
  "${removed_containers}" "${removed_networks}" "${already_removed_containers}"
exit "${cleanup_status}"
