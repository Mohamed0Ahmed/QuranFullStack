#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BACKEND_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
REPO_ROOT="$(cd "$BACKEND_ROOT/.." && pwd)"
OUTPUT="$REPO_ROOT/Frontend/quran-dashboard-ui/openapi/swagger.json"

cd "$BACKEND_ROOT"

echo "Restoring local tools..."
dotnet tool restore

echo "Building API (Release)..."
dotnet build api/QuranDashboard.Api/QuranDashboard.Api.csproj -c Release

echo "Exporting OpenAPI spec..."
mkdir -p "$(dirname "$OUTPUT")"
# Run from the publish output so the host's content root contains appsettings.json;
# generation only builds the DI container and never opens a database connection.
cd api/QuranDashboard.Api/bin/Release/net10.0
dotnet swagger tofile --output "$OUTPUT" QuranDashboard.Api.dll v1

echo "Wrote $OUTPUT"
