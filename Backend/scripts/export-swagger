#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BACKEND_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
REPO_ROOT="$(cd "$BACKEND_ROOT/.." && pwd)"
OUTPUT="$REPO_ROOT/Frontend/quran-dashboard-ui/openapi/swagger.json"

cd "$BACKEND_ROOT"

echo "Restoring local tools..."
dotnet tool restore

echo "Building API (Release)..."
dotnet build api/QuranDashboard.Api/QuranDashboard.Api.csproj \
  -c Release \
  --disable-build-servers \
  -m:1 \
  -p:BuildInParallel=false \
  -v minimal

echo "Exporting OpenAPI spec..."
mkdir -p "$(dirname "$OUTPUT")"
# Run from the publish output so the host's content root contains appsettings.json.
# The Swashbuckle CLI runs the entry point through to application start, so the startup
# permission-catalogue sync would otherwise write to whatever database appsettings names.
# Generating a spec must never mutate a database, so the sync is switched off here.
cd api/QuranDashboard.Api/bin/Release/net10.0
ASPNETCORE_ENVIRONMENT="${ASPNETCORE_ENVIRONMENT:-Development}" \
  Access__PermissionCatalogueStartupSync__Enabled=false \
  dotnet swagger tofile --output "$OUTPUT" QuranDashboard.Api.dll v1

echo "Wrote $OUTPUT"
