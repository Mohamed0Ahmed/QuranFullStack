{
  "name": "quran-dashboard-ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:https": "ng serve --ssl --ssl-cert localhost.pem --ssl-key localhost-key.pem",
    "build": "ng build",
    "check:permission-catalogue": "node scripts/check-permission-catalogue.mjs",
    "check:audit-action-types": "node scripts/check-audit-action-types.mjs",
    "check:no-unit-specs": "node scripts/check-no-unit-specs.mjs",
    "check:e2e-database-contract": "node scripts/verify-e2e-database-contract.mjs",
    "check:sealed-e2e-contract": "node scripts/verify-sealed-e2e-contract.mjs",
    "check:playwright-policy": "node scripts/verify-playwright-policy-contract.mjs",
    "check:canonical-playwright-runtime": "node scripts/verify-canonical-playwright-runtime.mjs",
    "check:independent-playwright-oracles": "node scripts/verify-independent-playwright-oracles.mjs",
    "check:repository-test-policy": "node ../../scripts/verify-test-policy-runner.mjs",
    "check:playwright-journeys": "node scripts/verify-playwright-journey-discovery.mjs && npm run e2e:discover:critical",
    "typecheck:app": "timeout --signal=TERM --kill-after=30s 10m tsc -p tsconfig.app.json --noEmit",
    "typecheck": "npm run typecheck:app",
    "build:verify": "timeout --signal=TERM --kill-after=30s 10m ng build",
    "test:pre-pr": "npm run check:permission-catalogue && npm run check:audit-action-types && npm run check:no-unit-specs && npm run check:playwright-policy && npm run check:canonical-playwright-runtime && npm run check:independent-playwright-oracles && npm run check:repository-test-policy && npm run check:playwright-journeys && npm run check:e2e-database-contract && npm run check:sealed-e2e-contract && npm run typecheck && npm run build:verify",
    "e2e": "node scripts/run-sealed-playwright.mjs --full",
    "e2e:critical": "node scripts/run-sealed-playwright.mjs --critical",
    "e2e:focused": "node scripts/run-focused-playwright.mjs",
    "e2e:canonical": "node scripts/run-canonical-playwright.mjs --full",
    "e2e:canonical:critical": "node scripts/run-canonical-playwright.mjs --critical",
    "e2e:canonical:focused": "node scripts/run-canonical-playwright.mjs --focused",
    "e2e:provision": "node scripts/provision-sealed-playwright.mjs",
    "e2e:local": "playwright test --workers=1",
    "e2e:critical:local": "node scripts/run-critical-playwright-journeys.mjs",
    "e2e:discover:critical": "playwright test --list --reporter=./scripts/discover-playwright-journeys.mjs",
    "e2e:discover:policies": "playwright test --list --reporter=./scripts/discover-playwright-policies.mjs",
    "e2e:headed": "playwright test --headed",
    "e2e:ui": "playwright test --ui",
    "e2e:typecheck": "tsc -p e2e/tsconfig.e2e.json --noEmit",
    "watch": "ng build --watch --configuration development",
    "generate:api": "ng-openapi-gen && node scripts/prune-generated-api.mjs",
    "generate:permission-codes": "node scripts/generate-permission-codes.mjs",
    "docs:api": "redocly build-docs openapi/swagger.json --disableGoogleFont --output ../../docs/api-reference/index.html && node scripts/inline-redoc-bundle.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^20.2.14",
    "@angular/common": "^20.3.30",
    "@angular/compiler": "^20.3.30",
    "@angular/core": "^20.3.30",
    "@angular/platform-browser": "^20.3.30",
    "@angular/router": "^20.3.30",
    "@logto/angular": "^1.0.4",
    "@logto/js": "^6.1.2",
    "angular-auth-oidc-client": "^21.0.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@angular/build": "^20.3.27",
    "@angular/cli": "^20.3.27",
    "@angular/compiler-cli": "^20.3.30",
    "@playwright/test": "^1.62.0",
    "@redocly/cli": "2.39.0",
    "@types/node": "^20.19.43",
    "autoprefixer": "^10.5.0",
    "ng-openapi-gen": "1.0.5",
    "postcss": "^8.5.15",
    "redoc": "2.5.3",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.2"
  }
}
