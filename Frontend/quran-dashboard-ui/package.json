{
  "name": "quran-dashboard-ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:https": "ng serve --ssl --ssl-cert localhost.pem --ssl-key localhost-key.pem",
    "build": "ng build",
    "test": "VITEST_MIN_FORKS=1 VITEST_MAX_FORKS=2 timeout --signal=TERM --kill-after=30s 15m ng test",
    "test:fast": "npm test -- --configuration=fast",
    "test:feature:access-admin": "npm test -- --configuration=feature-access-admin",
    "test:feature:abwab": "npm test -- --configuration=feature-abwab",
    "test:feature:auth": "npm test -- --configuration=feature-auth",
    "test:feature:dashboard": "npm test -- --configuration=feature-dashboard",
    "test:feature:mushaf": "npm test -- --configuration=feature-mushaf",
    "test:feature:words": "npm test -- --configuration=feature-words",
    "test:authorization": "npm test -- --configuration=authorization",
    "test:composition": "npm test -- --configuration=composition",
    "test:shared": "npm test -- --configuration=shared",
    "test:full": "npm test",
    "test:gates": "node testing/verify-test-gates.mjs",
    "check:permission-catalogue": "node scripts/check-permission-catalogue.mjs",
    "check:audit-action-types": "node scripts/check-audit-action-types.mjs",
    "typecheck:app": "timeout --signal=TERM --kill-after=30s 10m tsc -p tsconfig.app.json --noEmit",
    "typecheck:spec": "timeout --signal=TERM --kill-after=30s 10m tsc -p tsconfig.spec.json --noEmit",
    "typecheck": "npm run typecheck:app && npm run typecheck:spec",
    "build:verify": "timeout --signal=TERM --kill-after=30s 10m ng build",
    "test:pre-pr": "npm run check:permission-catalogue && npm run check:audit-action-types && npm run typecheck && npm run build:verify && npm run test:full",
    "e2e": "playwright test --project=default --workers=2 && playwright test --project=abwab --workers=1",
    "e2e:headed": "playwright test --headed",
    "e2e:ui": "playwright test --ui",
    "e2e:typecheck": "tsc -p e2e/tsconfig.e2e.json --noEmit",
    "watch": "ng build --watch --configuration development",
    "generate:api": "ng-openapi-gen && node scripts/prune-generated-api.mjs",
    "generate:permission-codes": "node scripts/generate-permission-codes.mjs",
    "docs:api": "redocly build-docs openapi/swagger.json --disableGoogleFont --output ../../docs/api-reference/index.html && node scripts/inline-redoc-bundle.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^20.2.14",
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "@logto/angular": "^1.0.4",
    "@logto/js": "^6.1.2",
    "angular-auth-oidc-client": "^21.0.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.27",
    "@angular/cli": "^20.3.27",
    "@angular/compiler-cli": "^20.3.0",
    "@playwright/test": "^1.62.0",
    "@redocly/cli": "2.39.0",
    "@types/node": "^20.19.43",
    "autoprefixer": "^10.5.0",
    "jsdom": "^29.1.1",
    "ng-openapi-gen": "1.0.5",
    "postcss": "^8.5.15",
    "redoc": "2.5.3",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.2",
    "vitest": "^3.2.6"
  }
}
