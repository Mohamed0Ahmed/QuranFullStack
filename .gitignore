# See https://docs.github.com/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# Compiled output
/dist
/build
/tmp
/out-tsc
/bazel-out

# Node
/node_modules
npm-debug.log
yarn-error.log
pnpm-debug.log
*.log
.npm/
.pnpm-store/

# IDEs and editors
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/*

# Miscellaneous
/.angular/cache
.env
.env.*
*.local
.sass-cache/
/connect.lock
/coverage
/libpeerconnection.log
testem.log
/typings
__screenshots__/

# Local HTTPS dev certs (mkcert localhost)
localhost.pem
localhost-key.pem

# System files
.DS_Store
Thumbs.db
*.tmp
*.swp

# Impeccable live mode (local config, server runtime, session journals)
.impeccable/
